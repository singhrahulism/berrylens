{
  "events": [
    {
      "type": "hello",
      "appName": "verify",
      "platform": "ios"
    },
    {
      "type": "event",
      "event": {
        "id": "net1",
        "timestamp": 0,
        "category": "network",
        "label": "GET /nearby 200 12ms",
        "durationMs": 12,
        "data": {
          "method": "GET",
          "url": "https://api.example.com/nearby",
          "status": 200,
          "ok": true
        }
      }
    }
  ],
  "steps": [
    {
      "keys": ["l"],
      "wait": 0.6,
      "expect": ["SWITCH LAYOUT", "Network Debug", "State Debug", "Full"]
    },
    {
      "keys": ["k"],
      "wait": 0.4,
      "expect": ["SWITCH LAYOUT"]
    },
    {
      "keys": ["enter"],
      "wait": 0.6,
      "expect": ["API CALLS", "QUERY CACHE"],
      "not_expect": ["NAV / SCREEN", "SWITCH LAYOUT"]
    },
    {
      "keys": ["l"],
      "wait": 0.4,
      "expect": ["SWITCH LAYOUT"]
    },
    {
      "keys": ["j"],
      "wait": 0.4,
      "expect": ["SWITCH LAYOUT"]
    },
    {
      "keys": ["enter"],
      "wait": 0.6,
      "expect": ["NAV / SCREEN", "GLOBAL STATE", "API CALLS", "QUERY CACHE", "CONSOLE / ERRORS"],
      "not_expect": ["SWITCH LAYOUT"]
    },
    {
      "keys": ["\u0016"],
      "wait": 0.6,
      "expect": ["NAV / SCREEN"]
    },
    {
      "keys": ["l"],
      "wait": 0.6,
      "expect": ["SWITCH LAYOUT", "Custom"]
    },
    {
      "keys": ["k"],
      "wait": 0.4,
      "expect": ["SWITCH LAYOUT"]
    },
    {
      "keys": ["enter"],
      "wait": 0.6,
      "expect": ["STORAGE", "NATIVE"],
      "not_expect": ["SWITCH LAYOUT"]
    },
    {
      "keys": ["l"],
      "wait": 0.4,
      "expect": ["Custom"]
    },
    {
      "keys": ["j"],
      "wait": 0.4,
      "expect": ["SWITCH LAYOUT"]
    },
    {
      "keys": ["enter"],
      "wait": 0.6,
      "expect": ["NAV / SCREEN"],
      "not_expect": ["STORAGE", "SWITCH LAYOUT"]
    }
  ]
}
